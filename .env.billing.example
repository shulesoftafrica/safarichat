# Shulesoft Billing API Configuration Example
# Add these variables to your .env file

# =============================================================================
# SHULESOFT BILLING API CREDENTIALS
# =============================================================================

# Base API URL - DO NOT change unless Shulesoft provides a different URL
BILLING_API_URL=https://shulesoftapi.shulesoft.africa/api

# Your organization's access token from Shulesoft Billing Platform
# Get this from: Shulesoft Dashboard → API Settings → Access Tokens
BILLING_ACCESS_TOKEN=your_bearer_token_here

# Your organization ID in the Shulesoft Billing system
# Get this from: Shulesoft Dashboard → Organization Settings → Organization ID
BILLING_ORGANIZATION_ID=your_organization_id_here

# SafariChat product ID in the Shulesoft catalog
# This is the ID of your "SafariChat" product entry in Shulesoft
# Get this from: Shulesoft Dashboard → Products → SafariChat → Product ID
BILLING_PRODUCT_ID=your_safarichat_product_id

# Price Plan ID for AI Credits
# This is the price plan used for wallet/credit top-ups
# Get this from: Shulesoft Dashboard → Products → SafariChat → Price Plans → AI Credits
BILLING_CREDITS_PRICE_PLAN_ID=your_credits_price_plan_id

# Wallet Credits Price Plan ID (for UCN generation)
# This is the specific price plan ID used to generate UCN for wallet top-ups
# Get this from: Billing API → Products → SafariChat AI Credits → Price Plans → ID
# Example: If you created a usage-based product "SAFARICHAT-AI-CREDITS", use its price plan ID
BILLING_WALLET_CREDITS_PRICE_PLAN_ID=your_wallet_credits_price_plan_id

# Optional: Webhook secret for payment confirmations
# Get this from: Shulesoft Dashboard → Webhooks → Secret Key
BILLING_WEBHOOK_SECRET=your_webhook_secret_here

# API timeout in seconds (default: 30)
BILLING_API_TIMEOUT=30

# =============================================================================
# CONFIGURATION NOTES
# =============================================================================

# 1. Organization ID Setup:
#    - Login to Shulesoft Billing Platform
#    - Navigate to Organization Settings
#    - Copy your Organization ID
#    - Paste it as BILLING_ORGANIZATION_ID value above

# 2. Product ID Setup:
#    - Go to Products section in Shulesoft Dashboard
#    - Find or create "SafariChat" product
#    - Copy the Product ID
#    - Paste it as BILLING_PRODUCT_ID value above

# 3. Price Plans Setup:
#    You need to create these price plans in Shulesoft for SafariChat:
#    a) Starter Plan (Monthly) - TZS 49,000
#    b) Pro Plan (Monthly) - TZS 149,000
#    c) Premium Plan (Monthly) - TZS 249,000
#    d) AI Credits (per 1000 credits) - Price per your business model
#    
#    After creating the "AI Credits" price plan, copy its ID to BILLING_CREDITS_PRICE_PLAN_ID

# 4. Access Token:
#    - Navigate to API Settings in Shulesoft Dashboard
#    - Generate a new API access token (if you don't have one)
#    - Copy the token
#    - Paste it as BILLING_ACCESS_TOKEN value above
#    - IMPORTANT: Keep this token secure, do not commit it to version control

# 5. Webhook Configuration (optional):
#    - Go to Webhooks section in Shulesoft Dashboard
#    - Create a new webhook endpoint: https://yourdomain.com/api/billing/webhook
#    - Copy the webhook secret
#    - Paste it as BILLING_WEBHOOK_SECRET value above
#    - This allows automatic payment confirmation updates

# =============================================================================
# TESTING
# =============================================================================

# Before going live, test the API integration:
# 1. Verify connection: php artisan tinker
#    > Http::withHeaders(['Authorization' => 'Bearer ' . config('services.billing.access_token')])->get(config('services.billing.api_url') . '/products/' . config('services.billing.product_id'))
#
# 2. Test price plans retrieval:
#    > Http::withHeaders(['Authorization' => 'Bearer ' . config('services.billing.access_token')])->get(config('services.billing.api_url') . '/products/' . config('services.billing.product_id') . '/price-plans')
#
# 3. Test invoice creation (use small amount for testing):
#    Call POST /api/billing/wallet/topup with amount=1000 via Postman/Insomnia

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================

# 1. Never commit .env file to version control
# 2. Rotate access tokens periodically (every 90 days recommended)
# 3. Use different tokens for development and production environments
# 4. Monitor API usage in Shulesoft Dashboard for anomalies
# 5. Implement rate limiting on your webhook endpoint
# 6. Validate webhook signatures using BILLING_WEBHOOK_SECRET

# =============================================================================
# SHULESOFT API ENDPOINTS REFERENCE
# =============================================================================

# The following endpoints are used by SafariChat:
# - POST   /api/invoices                           - Create new invoice
# - GET    /api/invoices/{id}/payment-gateways     - Get payment links for invoice
# - GET    /api/products/{id}/price-plans          - List all price plans for a product
# - POST   /api/webhooks/payment-confirmation      - Receive payment updates (incoming)

