# Production Environment Configuration
# Copy to .env for production deployment

# Application Settings
APP_NAME="SafariChat Notification API"
APP_ENV=production
APP_KEY=base64:your_32_character_app_key_here
APP_DEBUG=false
APP_URL=https://your-production-domain.com

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=your-production-db-host
DB_PORT=5432
DB_DATABASE=safarichat_production
DB_USERNAME=safarichat_user
DB_PASSWORD=your_secure_database_password

# Unified Notification API Configuration
UNIFIED_NOTIFICATION_API_URL=https://notifcations.shulesoft.africa/api
UNIFIED_NOTIFICATION_API_TOKEN=your_production_bearer_token_here
UNIFIED_NOTIFICATION_TIMEOUT=30
UNIFIED_NOTIFICATION_RETRY_ATTEMPTS=3

# WaSender API Configuration
WASENDER_API_URL=https://api.wa-sender.com
WASENDER_SESSION_TIMEOUT=300
WASENDER_MAX_CONCURRENT_SESSIONS=10

# Redis Configuration (for caching and queues)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Cache Configuration
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Logging Configuration
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAYS=30

# Rate Limiting
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=60

# Security Settings
SANCTUM_STATEFUL_DOMAINS=your-frontend-domain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# Monitoring
SENTRY_LARAVEL_DSN=your_sentry_dsn_here
TELESCOPE_ENABLED=false

# File Storage
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your_production_bucket

# CDN Configuration
CDN_URL=https://cdn.your-domain.com

# Performance Settings
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=256
OPCACHE_MAX_ACCELERATED_FILES=20000