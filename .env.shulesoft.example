# ============================================================================
# SHULESOFT BILLING API - OAUTH AUTHENTICATION
# ============================================================================
# This system now uses automatic OAuth authentication with token refresh
# 
# How it works:
# 1. Login with email/password → Get user access token
# 2. Use user token → Create OAuth client → Get client_id & client_secret  
# 3. Use client credentials → Get API access token (expires after 90 days)
# 4. On 401 errors, automatically refresh the token
#
# Benefits:
# ✓ No manual token management required
# ✓ Automatic token refresh on expiration
# ✓ Secure credential storage
# ✓ Seamless authentication
# ============================================================================

# Shulesoft API Base URL (no /v1 suffix needed)
SHULESOFT_API_URL=https://shulesoftapi.shulesoft.africa/api

# Authentication Credentials (for OAuth flow)
SHULESOFT_AUTH_EMAIL=admin@techsoft-solutions.com
SHULESOFT_AUTH_PASSWORD=password123

# Billing Configuration (your organization and product IDs)
BILLING_ORGANIZATION_ID=1
BILLING_PRODUCT_ID=your_product_id_here
BILLING_CREDITS_PRICE_PLAN_ID=3

# Webhook Configuration
BILLING_WEBHOOK_SECRET=your_webhook_secret_here

# API Timeout (seconds)
BILLING_API_TIMEOUT=30

# ============================================================================
# LEGACY CONFIGURATION (kept for backward compatibility)
# ============================================================================
# These are no longer required but kept for fallback scenarios
# The system will use OAuth authentication first, then fall back to these
# if OAuth fails for any reason
# ============================================================================

BILLING_API_URL=https://shulesoftapi.shulesoft.africa/api
BILLING_ACCESS_TOKEN=

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
# 1. SECURITY: Never commit credentials to version control
#    - Add .env to .gitignore
#    - Use different credentials for development vs production
#
# 2. FIRST-TIME SETUP:
#    - Set SHULESOFT_AUTH_EMAIL and SHULESOFT_AUTH_PASSWORD
#    - The system will automatically:
#      a) Login and get user token
#      b) Create OAuth client credentials
#      c) Get and cache access token
#      d) Refresh token automatically when it expires
#
# 3. TOKEN MANAGEMENT:
#    - Access tokens are cached for 89 days
#    - Tokens auto-refresh on 401 errors
#    - Client credentials are stored permanently in cache
#    - No manual token updates needed!
#
# 4. MONITORING:
#    - Check logs/laravel.log for authentication status
#    - Look for "Shulesoft access token refreshed" messages
#    - Use: php artisan tinker, then ShulesoftAuthService::getAuthStatus()
#
# 5. TROUBLESHOOTING:
#    - Clear auth cache: php artisan cache:forget shulesoft_access_token
#    - Force re-authentication: ShulesoftAuthService::clearAuthCache()
#    - Check API status: https://shulesoftapi.shulesoft.africa/api-docs
#
# ============================================================================
