# Meta WhatsApp Business API Configuration
# ==========================================
# 
# Copy these variables to your main .env file and fill in the values.
# Get these credentials from: https://business.facebook.com
#
# Setup Instructions:
# 1. Go to Meta Business Manager (business.facebook.com)
# 2. Navigate to WhatsApp > API Setup
# 3. Copy the Phone Number ID and Access Token
# 4. Add webhook verify token (create a random secure string)

# Required: Phone Number ID from Meta Business Manager
# Example: 1083367458184137
META_WHATSAPP_PHONE_NUMBER_ID=

# Required: Business Account ID from Meta Business Manager
# Example: 981178058418111
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Required: Permanent Access Token (never expires unless revoked)
# Get from: Meta Business Manager > System Users > Generate Token
# Permissions needed: whatsapp_business_messaging, whatsapp_business_management
# Example: EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_WHATSAPP_ACCESS_TOKEN=

# Optional: API Version (defaults to v24.0)
# Available versions: v24.0, v23.0, v22.0
META_WHATSAPP_API_VERSION=v24.0

# Required for Webhooks: Your custom verify token
# Create a random secure string (min 20 characters)
# Example: sk_whatsapp_verify_abc123xyz789
META_WHATSAPP_VERIFY_TOKEN=

# Optional: Base URL (only change if using on-premises installation)
META_WHATSAPP_BASE_URL=https://graph.facebook.com

# Optional: Test Mode
# Set to true to use test phone numbers (+1 555-xxxx)
META_WHATSAPP_TEST_MODE=false

# Optional: Rate Limits
# Standard tier: 80 messages/second
# Business tier: 1000 messages/second
META_WHATSAPP_RATE_LIMIT=80

# ==========================================
# Quick Setup Checklist:
# ==========================================
# 
# [ ] 1. Create Meta Business Account
# [ ] 2. Add WhatsApp Business Account
# [ ] 3. Add Phone Number to WhatsApp
# [ ] 4. Get Phone Number ID (appears in API Setup)
# [ ] 5. Create System User with permanent token
# [ ] 6. Assign WhatsApp permissions to system user
# [ ] 7. Generate access token (never expires)
# [ ] 8. Copy all credentials to .env
# [ ] 9. Create OTP template in Message Templates
# [ ] 10. Submit template for approval
# [ ] 11. Test with: php artisan tinker; testOtpSending();
# [ ] 12. Configure webhook URL in Meta Business Manager
#
# ==========================================
# Template Setup:
# ==========================================
#
# You MUST create and get approval for these templates:
#
# 1. OTP Template (Required)
#    Name: otp
#    Category: Authentication
#    Language: English
#    Body: Your verification code is {{1}}
#    Button: URL - https://yourapp.com/verify?code={{1}}
#
# 2. Payment Reminder (Optional)
#    Name: payment_reminder
#    Category: Utility
#    Language: English
#    Body: Hello {{1}}, your payment of {{2}} is due on {{3}}
#
# 3. Welcome Message (Optional)
#    Name: welcome_message
#    Category: Utility
#    Language: English
#    Body: Welcome to SafariChat, {{1}}! Your account is ready.
#
# ==========================================
# Webhook Configuration:
# ==========================================
#
# Webhook URL: https://yourapp.com/api/webhooks/meta-whatsapp
# Verify Token: [Use the META_WHATSAPP_VERIFY_TOKEN from above]
# 
# Subscribe to:
# - messages (receive incoming messages)
# - message_status (delivery receipts)
# - message_echoes (message sent confirmations)
#
# ==========================================
# Testing:
# ==========================================
#
# Run health check:
# php artisan tinker
# >>> $service = app('App\Services\MetaWhatsAppService');
# >>> $health = $service->getHealthStatus();
# >>> dd($health);
#
# Send test OTP:
# >>> $service->sendOtpTemplate('+255714825469', '123456');
#
# ==========================================
# Troubleshooting:
# ==========================================
#
# Error: "Access token invalid"
# - Solution: Generate new token from System Users
#
# Error: "Phone number not registered"
# - Solution: Add phone number in Business Manager
#
# Error: "Template not found"
# - Solution: Create and get approval for templates
#
# Error: "Rate limit exceeded"
# - Solution: Reduce sending rate or upgrade tier
#
# All errors are logged to: storage/logs/laravel.log
#
# ==========================================
